<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/google_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 顶部的装饰大图标 -->
        <ImageView
            android:id="@+id/ivDialogHeaderIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_material_star"
            app:tint="@color/google_action_primary"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/rate_star_header_desc" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvRateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rate_dialog_default_title"
            android:textColor="@color/google_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 描述 -->
        <TextView
            android:id="@+id/tvRateDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rate_dialog_default_desc"
            android:textColor="@color/google_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4sp" />

        <!-- 星星选择器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivStar1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:src="@drawable/ic_material_star"
                app:tint="@color/google_text_secondary"
                android:contentDescription="@string/rate_star_1_desc"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:id="@+id/ivStar2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:src="@drawable/ic_material_star"
                app:tint="@color/google_text_secondary"
                android:contentDescription="@string/rate_star_2_desc"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp"/>

            <ImageView
                android:id="@+id/ivStar3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:src="@drawable/ic_material_star"
                app:tint="@color/google_text_secondary"
                android:contentDescription="@string/rate_star_3_desc"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp"/>

            <ImageView
                android:id="@+id/ivStar4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:src="@drawable/ic_material_star"
                app:tint="@color/google_text_secondary"
                android:contentDescription="@string/rate_star_4_desc"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp"/>

            <ImageView
                android:id="@+id/ivStar5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:src="@drawable/ic_material_star"
                app:tint="@color/google_text_secondary"
                android:contentDescription="@string/rate_star_5_desc"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- 按钮容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- 取消/残忍拒绝 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/google_action_secondary"
                android:text="@string/rate_dialog_btn_cancel"
                android:textColor="@color/google_action_secondary_text"
                app:cornerRadius="16dp"
                android:textAllCaps="false"
                android:minHeight="48dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <!-- 好评支持/吐槽反馈 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/google_action_primary"
                android:enabled="false"
                android:text="@string/rate_dialog_btn_action_default"
                android:textColor="@color/google_action_primary_text"
                app:cornerRadius="16dp"
                android:textAllCaps="false"
                android:minHeight="48dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
